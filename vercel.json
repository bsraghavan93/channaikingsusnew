{
  "rewrites": [
    { "source": "/order/table/:table", "destination": "/order/index.html" },
    { "source": "/admin/tables", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
